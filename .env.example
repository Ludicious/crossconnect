# Copy to .env and fill in values for your environment.
# Never commit a .env with real secrets.

# SQLite dev default — swap for Postgres in production:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost/crossconnect
DATABASE_URL=sqlite:///./crossconnect.db

# Generate a real secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Session lifetime in seconds (default 86400 = 1 day)
# SESSION_MAX_AGE=86400
